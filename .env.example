# ============================================================
# FlowOS — variáveis de ambiente (modelo, SEM segredos reais)
# Copie para .env e preencha. Nunca commite o .env preenchido.
# Referência completa: docs/SISTEMA.md §10
# ============================================================

# ---------- Essenciais ----------
# Banco (Postgres/Supabase). Em dev, use um banco LOCAL — o .env de algumas
# máquinas aponta para produção e db:push/seed destroys dados.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowos?schema=public"

# Assina os JWTs (operador, KDS, cliente, admin SaaS). Rotacionar invalida
# todas as sessões. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-aleatorio"

# URL pública do app (links de tracking, bot, webhook de retorno)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Protege os crons (Authorization: Bearer $CRON_SECRET). Sem isso, as rotas
# de cron aceitam chamada manual.
CRON_SECRET="troque-por-um-segredo"

# Fuso usado nos relatórios financeiros e no "dia" do expediente
BUSINESS_TZ="America/Sao_Paulo"

# Exibe OTP/link de reset na resposta e nos logs. SOMENTE em dev.
SHOW_DEV_CODE="false"

# Versão do PWA/service worker (gerada no build se ausente)
# NEXT_PUBLIC_BUILD_ID="build-local"

# ---------- Pagamentos ----------
# Pagar.me (PIX, cartão, split)
PAGARME_API_KEY=""
PAGARME_ENVIRONMENT="sandbox"
PAGARME_WEBHOOK_KEY=""
PAGARME_SAAS_RECIPIENT_ID=""

# Inter (PIX) — também pode ser configurado por estabelecimento no banco
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
INTER_CERTIFICATE=""
INTER_CERTIFICATE_PASSWORD=""

# ---------- WhatsApp / Meta Cloud API ----------
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_CONFIG_ID=""

# Evolution API (WhatsApp não-oficial) — instância da plataforma
SAAS_EVOLUTION_BASE_URL=""
SAAS_EVOLUTION_API_KEY=""
SAAS_EVOLUTION_INSTANCE=""

# Tokens da própria conta SaaS no Meta (opcional)
SAAS_META_ACCESS_TOKEN=""
SAAS_META_PHONE_NUMBER_ID=""

# ---------- IA (bot) ----------
OPENAI_API_KEY=""

# ---------- Marketplaces ----------
IFOOD_CLIENT_ID=""
IFOOD_CLIENT_SECRET=""
# Segredo do webhook 99Entrega — SEM ele o webhook aceita chamadas sem
# assinatura (fail-open). Defina em produção.
WEBHOOK_99_SECRET=""
# O segredo do webhook do iFood também pode ser configurado por tenant no banco
# IFOOD_WEBHOOK_SECRET=""

# ---------- Storage (imagens) / Push ----------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:suporte@flowos.com.br"
