{
  "functions": {
    "src/app/api/cron/*/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/orders/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ifood-catalog/sync/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/verify-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reset-ai-usage",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/sync-ifood-status",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meta-quota",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire-orders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/replay-webhooks",
      "schedule": "*/10 * * * *"
    }
  ]
}
